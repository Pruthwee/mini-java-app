# Docker ignore file for Java Maven projects
# Exclude build artifacts, IDE files, and wrapper scripts

# Maven build artifacts
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Maven wrapper (CRITICAL: Never include in Docker image)
mvnw
mvnw.cmd
.mvn/

# Gradle wrapper (CRITICAL: Never include in Docker image)
gradlew
gradlew.bat
gradle/wrapper/

# IDE files
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Git files
.git/
.gitignore
.gitattributes

# Documentation
*.md
README*
LICENSE
CHANGELOG*

# Docker files
Dockerfile
docker-compose.yml
.dockerignore

# Logs
*.log
logs/

# Test files
src/test/

# CI/CD
.github/
.gitlab-ci.yml
Jenkinsfile
.travis.yml
