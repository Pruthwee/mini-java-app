<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.test</groupId>
    <artifactId>mini-java-app</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- AWS SDK v2 BOM - version 2.57.4 from Maven Central lookup (maven-metadata.xml <latest>) -->
            <!-- serves blockers: blocker-1..7 (cr-java-0061, cr-java-0063 S3), blocker-8..10,16 (cr-java-0069, cr-java-0113 Secrets Manager), blocker-20 (cr-java-0070 SSM), blocker-17..19 (cr-java-0073, cr-java-0097) -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>2.57.4</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>8.0.33</version>
        </dependency>
        
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <version>2.7.0</version>
        </dependency>

        <!-- AWS SDK v2 S3 - serves blocker-1..7 (cr-java-0061 Hard-coded File Paths, cr-java-0063 java.io.File storage) -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>

        <!-- AWS SDK v2 Secrets Manager - serves blocker-8..10 (cr-java-0069 DB credentials), blocker-16 (cr-java-0113 secrets) -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>secretsmanager</artifactId>
        </dependency>

        <!-- AWS SDK v2 SSM - serves blocker-20 (cr-java-0070 classpath properties -> Parameter Store) -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>ssm</artifactId>
        </dependency>

        <!-- HikariCP connection pool - serves blocker-17..18 (cr-java-0073 Direct JDBC), blocker-19 (cr-java-0097 timeouts) -->
        <!-- version 5.1.0 per remediation detail, compatible with Java 11 -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>5.1.0</version>
        </dependency>

        <!-- Jackson jackson-databind is already a transitive dependency of spring-boot-starter-web -->
        <!-- No explicit declaration needed; used for Secrets Manager JSON parsing (blocker-8..10,16) -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>11</source>
                    <target>11</target>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
